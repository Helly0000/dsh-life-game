{
  "name": "dsh-life-game",
  "version": "0.1.0",
  "description": "Conway's Game of Life for DeepSeek Harness — a sidebar panel row and a full centre-column board with drawing, patterns, four rules and a population chart. / 康威生命游戏：侧栏面板入口 + 中央棋盘，可绘制、可盖图案，含四套规则与种群曲线。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Helly0000/dsh-life-game.git"
  },
  "homepage": "https://github.com/Helly0000/dsh-life-game#readme",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs && node test/life.spec.mjs && node test/bundle.spec.mjs",
    "prepare": "node build.mjs"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "game",
    "conway",
    "life",
    "cellular-automata"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
